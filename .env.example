# Production env vars for Render (set in Render > Environment):
#
# APP_SECRET_TOKEN   Shared secret; requests must send it as the x-app-token
#                    header. REQUIRED in production. Generate with:
#                    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ALLOWED_ORIGIN     Comma-separated allowlist of frontend origins, e.g.
#                    https://your-app.vercel.app (recommended in production)
# RATE_LIMIT_PER_MIN Per-IP request limit per minute (default 60)
# BLOCK_PRIVATE_HOSTS Set to "true" to block requests to localhost/private
#                    IPs (SSRF guard). Leave unset to allow Ollama/local
#                    endpoints.
# UPSTREAM_TIMEOUT_MS  Upstream call timeout (default 120000)
